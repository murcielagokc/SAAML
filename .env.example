# Entorno y Servidor
ENVIRONMENT=development
PROJECT_NAME="SAAML - Sistema de Aprovisionamiento Autónomo"
VERSION="1.0.0-beta"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# MongoDB Atlas / Local (RNF03)
# Reemplazar con la URI de tu clúster de MongoDB Atlas si aplica
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="saaml_db"

# Seguridad y Criptografía (RNF-SEG)
# Generar una clave secreta segura en producción: openssl rand -hex 32
SECRET_KEY="supersecret_saaml_dev_key_change_in_production_99887766"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Restricciones y Timeouts de Optimización (RNF01)
MAX_OPTIMIZATION_SECONDS=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
